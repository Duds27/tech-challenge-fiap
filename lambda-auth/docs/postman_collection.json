{
  "info": {
    "name": "Oficina — Auth por CPF (Fase 3)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://<api-id>.execute-api.us-east-1.amazonaws.com" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "POST /auth (autenticar por CPF)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('token', pm.response.json().token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cpf\": \"529.982.247-25\"\n}"
        }
      }
    },
    {
      "name": "GET /api/clientes (protegida)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/clientes"
      }
    }
  ]
}
